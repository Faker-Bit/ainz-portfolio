        "from __future__ import annotations",
        "",
        "from fastapi import APIRouter, Depends, Query",
        "from fastapi.responses import StreamingResponse",
        "from sqlalchemy.ext.asyncio import AsyncSession",
        "",
        "from app.database.session import get_db",
        "from app.providers.registry import ProviderRegistry",
        "from app.schemas import AgentRunCreate, ChatRequest, FollowupRequest, RegenerateRequest, ResearchRequest",
        "from app.services import agent_service, chat_service, research_service",
        "",
        "router = APIRouter(tags=[\"chat\"])",
        "",
        "",
        "@router.post(\"/chat/stream\")",
        "async def chat_stream(req: ChatRequest, db: AsyncSession = Depends(get_db)):",
        "    registry = ProviderRegistry(db)",
        "",
        "    async def event_gen():",
        "        try:",
        "            async for chunk in chat_service.stream_chat(db, req, registry):",
        "                yield chunk",
        "        except Exception as exc:",
        "            import json",
        "",
        "            yield f\"event: error\\ndata: {json.dumps({'message': str(exc), 'code': 'stream_error'})}\\n\\n\"",
        "            yield \"event: done\\ndata: {\\\"ok\\\": false}\\n\\n\"",
        "",
        "    return StreamingResponse(",
        "        event_gen(),",
        "        media_type=\"text/event-stream\",",
        "        headers={",
        "            \"Cache-Control\": \"no-cache\",",
        "            \"Connection\": \"keep-alive\",",
        "            \"X-Accel-Buffering\": \"no\",",
        "        },",
        "    )",
        "",
        "",
        "@router.post(\"/chat/regenerate\")",
        "async def regenerate(req: RegenerateRequest, db: AsyncSession = Depends(get_db)):",
        "    registry = ProviderRegistry(db)",
        "",
        "    async def event_gen():",
        "        try:",
        "            async for chunk in chat_service.regenerate_message(",
        "                db,",
        "                req.conversation_id,",
        "                req.message_id,",
        "                registry,",
        "                req.provider,",
        "                req.model,",
        "                req.mode,",
        "                req.web_search,",
        "            ):",
        "                yield chunk",
        "        except Exception as exc:",
        "            import json",
        "",
        "            yield f\"event: error\\ndata: {json.dumps({'message': str(exc), 'code': 'stream_error'})}\\n\\n\"",
        "",
        "    return StreamingResponse(event_gen(), media_type=\"text/event-stream\", headers={\"Cache-Control\": \"no-cache\"})",
        "",
        "",
        "@router.post(\"/chat/followups\")",
        "async def chat_followups(req: FollowupRequest, db: AsyncSession = Depends(get_db)):",
        "    registry = ProviderRegistry(db)",
        "    suggestions = await chat_service.generate_followups(",
        "        db, req.conversation_id, req.message_id, registry, req.provider, req.model",
        "    )",
        "    return {\"suggestions\": suggestions}",
        "",
        "",
        "@router.get(\"/usage/summary\")",
        "async def usage_summary(db: AsyncSession = Depends(get_db)):",
        "    return await chat_service.usage_summary(db)",
        "",
        "",
        "@router.post(\"/research/stream\")",
        "async def research_stream(req: ResearchRequest, db: AsyncSession = Depends(get_db)):",
        "    registry = ProviderRegistry(db)",
        "",
        "    async def event_gen():",
        "        try:",
        "            async for chunk in research_service.run_research(db, req, registry):"
